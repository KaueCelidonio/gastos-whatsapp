# Copie para .env e preencha. NUNCA commite o .env.

# Banco de dados (SQLite em dev; para PostgreSQL use, por exemplo:
# postgresql+psycopg://usuario:senha@localhost:5432/gastos)
DATABASE_URL=sqlite:///./gastos.db

# Fuso horário usado para "hoje", "ontem", semana e mês
TIMEZONE=America/Sao_Paulo

# Arquivo com categorias e palavras-chave
CATEGORIES_FILE=config/categorias.json

# --- WhatsApp Cloud API (Meta) ---
# Token de acesso (temporário ou de usuário do sistema), em "WhatsApp > Configuração da API"
WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone de teste, na mesma tela
WHATSAPP_PHONE_NUMBER_ID=
# Chave secreta do app, em "Configurações do app > Básico" (valida a assinatura do webhook)
WHATSAPP_APP_SECRET=
# Texto livre que você inventa e repete na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Versão da Graph API
WHATSAPP_API_VERSION=v23.0
